prefix=/work/test/ffmpegTest/install/ffmpeg
exec_prefix=${prefix}
libdir=/work/test/ffmpegTest/install/ffmpeg/lib
includedir=/work/test/ffmpegTest/install/ffmpeg/include

Name: libavformat
Description: FFmpeg container format library
Version: 59.27.100
Requires: 
Requires.private: libavcodec >= 59.37.100, libswresample >= 4.7.100, libavutil >= 57.28.100
Conflicts:
Libs: -L${libdir}  -lavformat 
Libs.private: -lm -latomic
Cflags: -I${includedir}
